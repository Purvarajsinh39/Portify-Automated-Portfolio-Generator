@model List<Portify.Models.Portfolio>
@{
    Layout = null;
    var templateNames = ViewBag.TemplateNames as Dictionary<int, string> ?? new Dictionary<int, string>();
}
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard | Portify</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">

    <script>
        (function () {
            const theme = localStorage.getItem('theme');
            if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        })();
    </script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        serif: ['Playfair Display', 'serif']
                    },
                    colors: {
                        brand: {
                            50: '#faf5ff',
                            100: '#f3e8ff',
                            300: '#d8b4fe',
                            500: '#a855f7',
                            600: '#9333ea',
                            900: '#581c87'
                        }
                    },
                    animation: {
                        'pulse-slow': 'pulse 4s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                    }
                }
            }
        }
    </script>

    <style>
        .noise-bg {
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.05'/%3E%3C/svg%3E");
        }

        .glass {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(0, 0, 0, 0.05);
        }

        .dark .glass {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .portfolio-card {
            transition: all 0.3s ease;
        }
        .portfolio-card:hover {
            transform: translateY(-4px);
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #050505; }
        ::-webkit-scrollbar-thumb { background: #a855f7; border-radius: 10px; }

        /* Toast animations */
        @@keyframes toastIn {
            from { opacity: 0; transform: translateY(-20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @@keyframes toastOut {
            from { opacity: 1; transform: translateY(0); }
            to { opacity: 0; transform: translateY(-20px); }
        }

        /* Sweet Popup Animation */
        @@keyframes sweetPopup {
            0% { opacity: 0; transform: scale(0.9) translateY(30px); }
            100% { opacity: 1; transform: scale(1) translateY(0); }
        }
        .modal-animate-in {
            animation: sweetPopup 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
        }
        .modal-animate-out {
            animation: sweetPopup 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) reverse forwards;
        }
    </style>
</head>

<body class="bg-white dark:bg-[#050505] text-gray-900 dark:text-white transition-colors duration-500 selection:bg-brand-500 selection:text-white min-h-screen flex flex-col">
    @Html.Partial("~/Views/Shared/_PageTransitions.cshtml")

    <!-- Background Ambient Effects -->
    <div class="fixed inset-0 z-0 pointer-events-none">
        <div class="absolute top-[20%] left-[20%] w-[40%] h-[40%] bg-brand-500/10 rounded-full blur-[120px] animate-pulse-slow"></div>
        <div class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] bg-blue-500/10 rounded-full blur-[120px] animate-pulse-slow" style="animation-delay: 1s;"></div>
        <div class="absolute inset-0 noise-bg opacity-30 dark:opacity-20"></div>
        <div class="absolute inset-0 bg-[url('https://grainy-gradients.vercel.app/noise.svg')] opacity-20"></div>
    </div>

    <div class="relative z-10 flex-grow flex flex-col">
        @Html.Partial("~/Views/Shared/_UserNavbar.cshtml")

        <main class="flex-grow p-6 sm:p-10 max-w-7xl mx-auto w-full">

            <!-- Success Toast -->
            @if (TempData["SuccessMessage"] != null)
            {
                <script>
                    window.addEventListener('load', () => {
                        setTimeout(() => {
                            showToast("@TempData["SuccessMessage"]", "success");
                        }, 500);
                    });
                </script>
            }

            <!-- Page Header -->
            <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4">
                <div>
                    <h2 class="text-xs uppercase tracking-[0.4em] text-brand-500 font-bold mb-2">Welcome Back</h2>
                    <h1 class="text-4xl md:text-5xl font-serif italic text-gray-900 dark:text-white">
                        My <span class="not-italic text-transparent bg-clip-text bg-gradient-to-r from-brand-600 to-blue-600 dark:from-brand-400 dark:to-blue-400">Portfolios</span>
                    </h1>
                </div>

                <div class="flex items-center gap-4">
                    <div class="text-sm text-gray-500 dark:text-gray-400 font-sans">
                        Total: <span class="font-bold text-gray-900 dark:text-white">@Model.Count</span>
                    </div>
                    <a href="@Url.Action("Explore", "Dashboard")"
                       class="inline-flex items-center gap-2 px-6 py-3 rounded-xl text-sm font-bold uppercase tracking-wider
                              bg-gradient-to-r from-brand-600 to-brand-500 text-white
                              hover:from-brand-500 hover:to-brand-600 hover:shadow-[0_0_30px_rgba(168,85,247,0.3)]
                              hover:-translate-y-0.5
                              transition-all duration-300 shadow-lg">
                        <i data-lucide="plus" class="w-4 h-4"></i>
                        Create New
                    </a>
                </div>
            </div>

            @if (Model != null && Model.Count > 0)
            {
                <!-- Portfolios Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                    @foreach (var portfolio in Model)
                    {
                        var tName = templateNames.ContainsKey(portfolio.TemplateId) ? templateNames[portfolio.TemplateId] : "Unknown";
                        <div class="portfolio-card glass rounded-2xl overflow-hidden shadow-lg group">
                            <!-- Card Header with gradient -->
                            <div class="h-32 relative overflow-hidden">
                                <div class="absolute inset-0 bg-gradient-to-br from-brand-600/80 to-blue-600/80 dark:from-brand-500/60 dark:to-blue-500/60"></div>
                                <div class="absolute inset-0 noise-bg opacity-40"></div>
                                <div class="absolute inset-0 flex items-center justify-center">
                                    <div class="w-16 h-16 rounded-2xl bg-white/20 backdrop-blur-sm flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                                        <i data-lucide="file-text" class="w-8 h-8 text-white"></i>
                                    </div>
                                </div>
                                <!-- Portfolio ID Badge -->
                                <div class="absolute top-3 left-3">
                                    <span class="px-2 py-1 rounded-lg bg-white/20 backdrop-blur-sm text-white text-xs font-mono">#@portfolio.Id</span>
                                </div>
                            </div>

                            <!-- Card Body -->
                            <div class="p-5">
                                <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-1 truncate">
                                    @(string.IsNullOrEmpty(portfolio.Title) ? "Untitled Portfolio" : portfolio.Title)
                                </h3>

                                <div class="flex items-center gap-2 mb-3">
                                    <i data-lucide="layout-template" class="w-3.5 h-3.5 text-brand-500"></i>
                                    <span class="text-xs text-gray-500 dark:text-gray-400 font-medium">@tName</span>
                                </div>

                                <div class="flex items-center gap-2 mb-4">
                                    <i data-lucide="calendar" class="w-3.5 h-3.5 text-gray-400"></i>
                                    <span class="text-xs text-gray-400 dark:text-gray-500">@portfolio.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</span>
                                </div>

                                <!-- Actions -->
                                <div class="flex items-center gap-2 pt-3 border-t border-gray-100 dark:border-white/5">
                                    <a href="@Url.Action("Download", "Portfolio", new { id = portfolio.Id })"
                                       data-no-transition="true"
                                       class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider
                                              bg-gradient-to-r from-brand-600 to-brand-500 text-white
                                              hover:from-brand-500 hover:to-brand-600 hover:shadow-[0_0_20px_rgba(168,85,247,0.25)]
                                              transition-all duration-200">
                                        <i data-lucide="download" class="w-3.5 h-3.5"></i>
                                        Download
                                    </a>

                                    @{
                                        string pTitle = portfolio.Title ?? "Portfolio";
                                        // Match backend sanitization: replace invalid filename chars and spaces with underscores
                                        char[] invalidChars = System.IO.Path.GetInvalidFileNameChars();
                                        string safeTitle = string.Join("_", pTitle.Split(invalidChars)).Replace(" ", "_");
                                        string fileName = "Portfolios/" + safeTitle + "_" + portfolio.Id + ".html";
                                    }

                                    <button type="button"
                                            onclick="copyPortfolioLink('@fileName', '@(pTitle.Replace("'", "\\'"))')"
                                            class="inline-flex items-center justify-center p-2.5 rounded-xl
                                                   border border-gray-200 dark:border-white/10
                                                   text-gray-400 hover:text-brand-500 hover:border-brand-500/30 dark:hover:border-brand-500/30
                                                   transition-all duration-200"
                                            title="Copy live link">
                                        <i data-lucide="link" class="w-3.5 h-3.5"></i>
                                    </button>

                                    <button type="button"
                                            onclick="openDeleteModal(@portfolio.Id, '@(portfolio.Title?.Replace("'", "\\'") ?? "Untitled Portfolio")')"
                                            class="inline-flex items-center justify-center p-2.5 rounded-xl
                                                   border border-gray-200 dark:border-white/10
                                                   text-gray-400 hover:text-red-500 hover:border-red-500/30 dark:hover:border-red-500/30
                                                   transition-all duration-200"
                                            title="Delete portfolio">
                                        <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- Empty State -->
                <div class="glass rounded-3xl p-16 text-center shadow-2xl relative overflow-hidden">
                    <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-brand-500 to-transparent opacity-50"></div>

                    <div class="w-20 h-20 mx-auto mb-6 rounded-2xl bg-gradient-to-br from-brand-50 to-brand-100 dark:from-brand-900/20 dark:to-brand-800/20 flex items-center justify-center">
                        <i data-lucide="folder-open" class="w-10 h-10 text-brand-500 opacity-60"></i>
                    </div>

                    <h2 class="text-2xl font-serif italic text-gray-900 dark:text-white mb-3">No portfolios yet</h2>
                    <p class="text-gray-500 dark:text-gray-400 mb-8 max-w-md mx-auto">
                        You haven't created any portfolios yet. Explore our templates and build your first one!
                    </p>

                    <a href="@Url.Action("Explore", "Dashboard")"
                       class="inline-flex items-center gap-2 px-8 py-4 rounded-xl text-sm font-bold uppercase tracking-wider
                              bg-gradient-to-r from-brand-600 to-brand-500 text-white
                              hover:from-brand-500 hover:to-brand-600 hover:shadow-[0_0_30px_rgba(168,85,247,0.3)]
                              hover:-translate-y-0.5
                              transition-all duration-300 shadow-lg">
                        <i data-lucide="compass" class="w-4 h-4"></i>
                        Explore Templates
                    </a>
                </div>
            }

        </main>
    </div>

    <!-- Deletion Modal (existing) -->
    <!-- Deletion Modal (existing) -->
    <div id="deleteModal" class="fixed inset-0 z-[100] hidden flex items-center justify-center px-4 bg-black/60 backdrop-blur-sm transition-all duration-500 opacity-0">
        <div class="glass max-w-md w-full rounded-3xl overflow-hidden shadow-2xl p-8 text-center" id="modalContent">
            <div class="p-8 text-center">
                <div class="w-16 h-16 mx-auto mb-6 rounded-2xl bg-red-500/10 flex items-center justify-center">
                    <i data-lucide="alert-triangle" class="w-8 h-8 text-red-500"></i>
                </div>
                <h3 class="text-xl font-serif italic text-gray-900 dark:text-white mb-2">Delete Portfolio?</h3>
                <p class="text-gray-500 dark:text-gray-400 text-sm mb-8">
                    This action cannot be undone. Are you sure you want to permanently delete <span id="portfolioNamePlaceholder" class="font-bold text-gray-900 dark:text-white"></span>?
                </p>
                <div class="flex flex-col sm:flex-row gap-3">
                    <button type="button" onclick="closeDeleteModal()" 
                            class="flex-1 px-6 py-3 rounded-xl text-sm font-bold uppercase tracking-wider
                                   bg-gray-100 dark:bg-white/5 text-gray-600 dark:text-gray-300
                                   hover:bg-gray-200 dark:hover:bg-white/10 transition-all">
                        Cancel
                    </button>
                    <form id="deleteForm" action="@Url.Action("DeletePortfolio", "Dashboard")" method="post" class="flex-1">
                        <input type="hidden" name="portfolioId" id="modalPortfolioId" />
                        <button type="submit" 
                                class="w-full px-6 py-3 rounded-xl text-sm font-bold uppercase tracking-wider
                                       bg-red-500 text-white hover:bg-red-600 hover:shadow-[0_0_20px_rgba(239,68,68,0.3)]
                                       transition-all">
                            Confirm Delete
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Creation Success Modal -->
    <div id="successModal" class="fixed inset-0 z-[110] hidden flex items-center justify-center px-4 bg-black/60 backdrop-blur-sm transition-all duration-500 opacity-0">
        <div class="glass max-w-lg w-full rounded-3xl overflow-hidden shadow-2xl p-8 text-center" id="successModalContent">
            <div class="w-20 h-20 mx-auto mb-6 rounded-3xl bg-green-500/10 flex items-center justify-center">
                <i data-lucide="check-circle" class="w-10 h-10 text-green-500"></i>
            </div>
            <h2 class="text-3xl font-serif italic text-gray-900 dark:text-white mb-2">Deployed Successfully!</h2>
            <p class="text-gray-500 dark:text-gray-400 mb-8">
                Your portfolio has been created and is now live. What would you like to do next?
            </p>
            
            <div class="grid grid-cols-1 gap-3">
                <a id="successDownloadBtn" href="#" class="flex items-center justify-center gap-3 px-6 py-4 rounded-2xl bg-brand-600 text-white font-bold uppercase tracking-wider hover:bg-brand-700 transition-all shadow-lg shadow-brand-500/20">
                    <i data-lucide="download" class="w-5 h-5"></i>
                    Download Portfolio
                </a>
                <button id="successCopyBtn" class="flex items-center justify-center gap-3 px-6 py-4 rounded-2xl bg-gray-100 dark:bg-white/5 text-gray-900 dark:text-white font-bold uppercase tracking-wider hover:bg-gray-200 dark:hover:bg-white/10 transition-all border border-gray-200 dark:border-white/5">
                    <i data-lucide="link" class="w-5 h-5"></i>
                    Copy Live Link
                </button>
                <button id="successReviewBtn" onclick="openReviewModal()" class="flex items-center justify-center gap-3 px-6 py-4 rounded-2xl border-2 border-brand-500/20 text-brand-500 font-bold uppercase tracking-wider hover:bg-brand-500/5 transition-all">
                    <i data-lucide="star" class="w-5 h-5"></i>
                    Submit Review
                </button>
            </div>
            
            <button onclick="closeSuccessModal()" class="mt-6 text-sm text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 underline underline-offset-4">
                Maybe later
            </button>
        </div>
    </div>

    <!-- Review Modal -->
    <div id="reviewModal" class="fixed inset-0 z-[120] hidden flex items-center justify-center px-4 bg-black/70 backdrop-blur-md transition-all duration-500 opacity-0">
        <div class="glass max-w-md w-full rounded-3xl overflow-hidden shadow-2xl p-8" id="reviewModalContent">
            <h3 class="text-2xl font-serif italic text-gray-900 dark:text-white mb-2">Submit Review</h3>
            <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">How was your experience with this template?</p>
            
            <form id="reviewForm" onsubmit="submitReview(event)">
                <input type="hidden" name="portfolioId" id="reviewPortfolioId" />
                <input type="hidden" name="templateId" id="reviewTemplateId" />
                
                <div class="mb-6">
                    <label class="block text-xs uppercase tracking-widest text-gray-400 mb-3 font-bold">Rating</label>
                    <div class="flex items-center gap-2" id="starRating">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <button type="button" onclick="setRating(@i)" class="star-btn p-1 text-gray-300 hover:text-amber-400 transition-all hover:scale-110" data-value="@i">
                                <i data-lucide="star" class="w-8 h-8 pointer-events-none"></i>
                            </button>
                        }
                    </div>
                    <input type="hidden" name="rating" id="reviewRating" value="0" />
                </div>
                
                <div class="mb-6">
                    <label class="block text-xs uppercase tracking-widest text-gray-400 mb-2 font-bold">Your Feedback</label>
                    <textarea name="message" required class="w-full h-32 rounded-2xl bg-gray-50 dark:bg-white/5 border border-gray-200 dark:border-white/10 p-4 text-sm focus:ring-2 focus:ring-brand-500 outline-none transition-all dark:text-white" placeholder="Tell us what you liked or how we can improve..."></textarea>
                </div>
                
                <div class="flex gap-3">
                    <button type="button" onclick="closeReviewModal()" class="flex-1 px-6 py-3 rounded-xl text-sm font-bold uppercase tracking-wider bg-gray-100 dark:bg-white/5 text-gray-600 dark:text-gray-400">Cancel</button>
                    <button type="submit" class="flex-1 px-6 py-3 rounded-xl text-sm font-bold uppercase tracking-wider bg-brand-600 text-white hover:bg-brand-700 transition-all shadow-lg shadow-brand-500/20">Submit</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function toggleTheme() {
            if (document.documentElement.classList.contains('dark')) {
                document.documentElement.classList.remove('dark');
                localStorage.setItem('theme', 'light');
            } else {
                document.documentElement.classList.add('dark');
                localStorage.setItem('theme', 'dark');
            }
        }

        // Copy Link Logic
        function copyPortfolioLink(relativeUrl, title) {
            const url = window.location.origin + "/" + relativeUrl;
            navigator.clipboard.writeText(url).then(() => {
                showToast(`Link for "${title}" copied!`);
            }).catch(err => {
                console.error('Could not copy text: ', err);
                // Fallback for non-HTTPS if needed
                const textArea = document.createElement("textarea");
                textArea.value = url;
                document.body.appendChild(textArea);
                textArea.select();
                try {
                    document.execCommand('copy');
                    showToast(`Link for "${title}" copied!`);
                } catch (e) {
                    console.error('Fallback copy failed', e);
                }
                document.body.removeChild(textArea);
            });
        }

        function showToast(message, type = 'success') {
            const toast = document.createElement('div');
            // Higher Z-index to stay above modals (130+)
            toast.className = 'fixed top-6 right-6 z-[200] flex items-center gap-4 px-6 py-4 rounded-2xl shadow-[0_20px_50px_rgba(0,0,0,0.2)] border transition-all duration-500 transform translate-y-[-20px] opacity-0';
            
            // Theme aware styling
            const isDark = document.documentElement.classList.contains('dark');
            if (isDark) {
                toast.style.background = 'rgba(20, 20, 20, 0.8)';
                toast.style.borderColor = 'rgba(255, 255, 255, 0.1)';
                toast.style.color = 'white';
            } else {
                toast.style.background = 'rgba(255, 255, 255, 0.95)';
                toast.style.borderColor = 'rgba(0, 0, 0, 0.05)';
                toast.style.color = '#1a1a1a';
            }
            toast.style.backdropFilter = 'blur(16px)';
            
            const iconColor = type === 'success' ? 'text-green-500' : 'text-amber-500';
            const iconBg = type === 'success' ? 'bg-green-500/10' : 'bg-amber-500/10';
            const iconName = type === 'success' ? 'check-circle' : 'info';

            toast.innerHTML = `
                <div class="w-10 h-10 rounded-xl ${iconBg} flex items-center justify-center">
                    <i data-lucide="${iconName}" class="w-5 h-5 ${iconColor}"></i>
                </div>
                <div class="flex flex-col">
                    <span class="text-[10px] font-bold uppercase tracking-[0.2em] opacity-50">${type}</span>
                    <span class="text-sm font-medium tracking-tight">${message}</span>
                </div>
            `;
            
            document.body.appendChild(toast);
            lucide.createIcons();

            // Animate In
            setTimeout(() => {
                toast.classList.remove('translate-y-[-20px]', 'opacity-0');
                toast.classList.add('translate-y-0', 'opacity-100');
            }, 10);

            // Animate Out
            setTimeout(() => {
                toast.classList.add('translate-y-[-20px]', 'opacity-0');
                setTimeout(() => toast.remove(), 500);
            }, 3500);
        }

        // --- Success Modal Logic ---
        function openSuccessModal(portfolioId, fileName, templateId) {
            const modal = document.getElementById('successModal');
            const content = document.getElementById('successModalContent');
            const downloadBtn = document.getElementById('successDownloadBtn');
            const copyBtn = document.getElementById('successCopyBtn');
            
            // Setup buttons
            downloadBtn.href = `/Portfolio/Download?id=${portfolioId}`;
            copyBtn.onclick = () => {
                copyPortfolioLink(fileName, 'Your new portfolio');
            };
            
            // Setup review data
            document.getElementById('reviewPortfolioId').value = portfolioId;
            document.getElementById('reviewTemplateId').value = templateId;

            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.add('opacity-100');
                content.classList.add('modal-animate-in');
            }, 10);
        }

        function closeSuccessModal() {
            const modal = document.getElementById('successModal');
            const content = document.getElementById('successModalContent');
            modal.classList.remove('opacity-100');
            content.classList.remove('modal-animate-in');
            content.classList.add('modal-animate-out');
            setTimeout(() => {
                modal.classList.add('hidden');
                content.classList.remove('modal-animate-out');
            }, 500);
        }

        // --- Review Logic ---
        function openReviewModal() {
            closeSuccessModal();
            const modal = document.getElementById('reviewModal');
            const content = document.getElementById('reviewModalContent');
            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.add('opacity-100');
                content.classList.add('modal-animate-in');
            }, 10);
            setRating(0); // Start with empty stars
        }

        function closeReviewModal() {
            const modal = document.getElementById('reviewModal');
            const content = document.getElementById('reviewModalContent');
            modal.classList.remove('opacity-100');
            content.classList.remove('modal-animate-in');
            content.classList.add('modal-animate-out');
            setTimeout(() => {
                modal.classList.add('hidden');
                content.classList.remove('modal-animate-out');
            }, 500);
        }

        function setRating(rating) {
            document.getElementById('reviewRating').value = rating;
            const stars = document.querySelectorAll('.star-btn');
            stars.forEach((star, index) => {
                const lucideIcon = star.querySelector('i');
                if (index < rating) {
                    star.classList.add('text-amber-400');
                    star.classList.remove('text-gray-300');
                    // Force re-render of lucide icon if needed or use class
                    star.innerHTML = `<i data-lucide="star" class="w-8 h-8 fill-current pointer-events-none"></i>`;
                } else {
                    star.classList.remove('text-amber-400');
                    star.classList.add('text-gray-300');
                    star.innerHTML = `<i data-lucide="star" class="w-8 h-8 pointer-events-none"></i>`;
                }
            });
            lucide.createIcons();
        }

        async function submitReview(event) {
            event.preventDefault();
            const rating = document.getElementById('reviewRating').value;
            
            if (rating == "0") {
                showToast("Please select a star rating", "warning");
                return;
            }
            
            const form = event.target;
            const formData = new FormData(form);
            
            try {
                const response = await fetch('/Portfolio/SubmitFeedback', {
                    method: 'POST',
                    body: formData
                });
                const result = await response.json();
                if (result.success) {
                    showToast("Thank you for your review!");
                    closeReviewModal();
                } else {
                    alert("Error: " + result.message);
                }
            } catch (error) {
                console.error("Error submitting review:", error);
            }
        }

        // Check for newly created portfolio on load
        window.addEventListener('load', () => {
            @if (TempData["NewlyCreatedPortfolioId"] != null)
            {
                <text>
                setTimeout(() => {
                    openSuccessModal(
                        @TempData["NewlyCreatedPortfolioId"], 
                        '@TempData["NewlyCreatedFileName"]', 
                        @TempData["NewlyCreatedTemplateId"]
                    );
                }, 800);
                </text>
            }
        });

        // Modal Logic
        function openDeleteModal(id, name) {
            const modal = document.getElementById('deleteModal');
            const content = document.getElementById('modalContent');
            document.getElementById('modalPortfolioId').value = id;
            document.getElementById('portfolioNamePlaceholder').innerText = name;
            
            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.add('opacity-100');
                content.classList.add('modal-animate-in');
            }, 10);
        }

        function closeDeleteModal() {
            const modal = document.getElementById('deleteModal');
            const content = document.getElementById('modalContent');
            modal.classList.remove('opacity-100');
            content.classList.remove('modal-animate-in');
            content.classList.add('modal-animate-out');
            setTimeout(() => {
                modal.classList.add('hidden');
                content.classList.remove('modal-animate-out');
            }, 500);
        }

        // Close modal on escape key
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && !document.getElementById('deleteModal').classList.contains('hidden')) {
                closeDeleteModal();
            }
        });

        // Theme handled in <head> for FOUC prevention
        lucide.createIcons();
    </script>
    @Html.Partial("~/Views/Shared/_Chatbot.cshtml")
</body>
</html>